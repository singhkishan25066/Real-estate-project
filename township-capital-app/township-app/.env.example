# MongoDB connection string (get one free at https://www.mongodb.com/cloud/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/township-capital

# Secret used to sign JWT auth tokens — use a long random string in production
# Generate one with: openssl rand -base64 32
JWT_SECRET=replace-this-with-a-long-random-string

# Optional: email of the account that should be promoted to admin on seed
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-please
